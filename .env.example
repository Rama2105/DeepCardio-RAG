# DeepCardio-RAG — environment template
#
# Copy this file to `.env` and adjust values for your machine:
#     Windows :  copy .env.example .env
#     Mac/Linux: cp .env.example .env
#
# `.env` is gitignored and must never be committed — it holds SECRET_KEY.
# Note: real environment variables take precedence over values in .env,
# so a stray `set MILVUS_HOST=...` in your shell will silently win.

# ── Server ────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false
RELOAD=false

# ── Training ──────────────────────────────────────────────────────────
# DEVICE is NOT read by any code — config.py has no device field and every
# consumer auto-detects via torch.cuda.is_available(). Documentation only.
DEVICE=cuda
BATCH_SIZE=128
MAX_EPOCHS=30
LEARNING_RATE=0.001

# ── Vector store ──────────────────────────────────────────────────────
# Must stay 768 — the collection is built at 768-dim with an L2 metric.
EMBEDDING_DIM=768
MILVUS_HOST=localhost
MILVUS_PORT=19530
USE_MILVUS_LITE=false
MILVUS_LITE=false

# ── Auth ──────────────────────────────────────────────────────────────
# Generate your own, do not reuse anyone else's:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
ALGORITHM=HS256
